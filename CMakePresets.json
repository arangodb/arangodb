{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "hidden": true,
      "name": "common-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USE_ENTERPRISE": "On",
        "STATIC_EXECUTABLES": "On",
        "USE_JEMALLOC": "On"
      }
    },
    {
      "hidden": true,
      "name": "x64",
      "cacheVariables": {
        "TARGET_ARCHITECTURE": "sandy-bridge",
        "USE_IPO": "On"
      }
    },
    {
      "hidden": true,
      "name": "arm64",
      "cacheVariables": {
        "TARGET_ARCHITECTURE": "graviton1",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "ASM_OPTIMIZATIONS": "Off",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "maintainer",
      "cacheVariables": {
        "USE_MAINTAINER_MODE": "On",
        "USE_GOOGLE_TESTS": "On",
        "USE_FAILURE_TESTS": "On"
      }
    },
    {
      "hidden": true,
      "name": "non-maintainer",
      "cacheVariables": {
        "USE_MAINTAINER_MODE": "Off",
        "USE_GOOGLE_TESTS": "Off",
        "USE_FAILURE_TESTS": "Off"
      }
    },
    {
      "hidden": true,
      "name": "tsan",
      "cacheVariables": {
        "USE_JEMALLOC": "Off",
        "STATIC_EXECUTABLES": "Off",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fsanitize-blacklist=${sourceDir}/tsan_blacklist.txt",
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "USE_MINIMAL_DEBUGINFO": "On",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "alubsan",
      "cacheVariables": {
        "USE_JEMALLOC": "Off",
        "STATIC_EXECUTABLES": "Off",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fsanitize=leak -fsanitize=undefined -fsanitize=float-divide-by-zero -fsanitize-address-use-after-return=never -fno-sanitize=vptr -fno-sanitize=alignment -fsanitize-blacklist=${sourceDir}/alubsan_blacklist.txt",
        "CMAKE_C_FLAGS": "-fsanitize=address -fsanitize=leak -fsanitize=undefined -fsanitize=float-divide-by-zero -fsanitize-address-use-after-return=never -fno-sanitize=alignment -fsanitize-blacklist=${sourceDir}/alubsan_blacklist.txt",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1 -rtlib=compiler-rt -fuse-ld=lld",
        "USE_MINIMAL_DEBUGINFO": "On",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "gcov",
      "cacheVariables": {
        "USE_COVERAGE": "On",
        "USE_JEMALLOC": "On",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "no-v8",
      "cacheVariables": {
        "USE_V8": "Off",
        "USE_FRONTEND": "Off"
      }
    },
    {
      "hidden": true,
      "name": "pr-base",
      "binaryDir": "${sourceDir}/build",
      "inherits": [
        "common-base"
      ],
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fno-stack-protector",
        "CMAKE_CXX_FLAGS": "-fno-stack-protector",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1 -fuse-ld=lld",
        "USE_STRICT_OPENSSL_VERSION": "On"
      }
    },
    {
      "name": "pr-non-maintainer-x64",
      "inherits": [
        "pr-base",
        "non-maintainer",
        "x64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition - x64"
    },
    {
      "name": "pr-non-maintainer-arm64",
      "inherits": [
        "pr-base",
        "non-maintainer",
        "arm64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition - ARM64"
    },
    {
      "name": "pr-x64",
      "inherits": [
        "pr-base",
        "maintainer",
        "x64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition Maintainer Mode - x64"
    },
    {
      "name": "pr-arm64",
      "inherits": [
        "pr-base",
        "maintainer",
        "arm64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition Maintainer Mode - ARM64"
    },
    {
      "name": "pr-x64-tsan",
      "inherits": [
        "tsan",
        "pr-x64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build) - x64"
    },
    {
      "name": "pr-arm64-tsan",
      "inherits": [
        "tsan",
        "pr-arm64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build) - ARM64"
    },
    {
      "name": "pr-x64-alubsan",
      "inherits": [
        "alubsan",
        "pr-x64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build) - x64"
    },
    {
      "name": "pr-arm64-alubsan",
      "inherits": [
        "alubsan",
        "pr-arm64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build) - ARM64"
    },
    {
      "name": "pr-x64-no-v8",
      "inherits": [
        "no-v8",
        "pr-x64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition Maintainer Mode (No V8/Frontend) - x64"
    },
    {
      "name": "pr-arm64-no-v8",
      "inherits": [
        "no-v8",
        "pr-arm64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition Maintainer Mode (No V8/Frontend) - ARM64"
    },
    {
      "name": "pr-x64-tsan-no-v8",
      "inherits": [
        "no-v8",
        "pr-x64-tsan"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build, No V8/Frontend) - x64"
    },
    {
      "name": "pr-arm64-tsan-no-v8",
      "inherits": [
        "no-v8",
        "pr-arm64-tsan"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build, No V8/Frontend) - ARM64"
    },
    {
      "name": "pr-x64-alubsan-no-v8",
      "inherits": [
        "no-v8",
        "pr-x64-alubsan"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build, No V8/Frontend) - x64"
    },
    {
      "name": "pr-arm64-alubsan-no-v8",
      "inherits": [
        "no-v8",
        "pr-arm64-alubsan"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build, No V8/Frontend) - ARM64"
    },
    {
      "name": "pr-x64-coverage",
      "inherits": [
        "gcov",
        "pr-x64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Coverage Build) - x64"
    },
    {
      "name": "pr-arm64-coverage",
      "inherits": [
        "gcov",
        "pr-arm64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Coverage Build) - ARM64"
    },
    {
      "hidden": true,
      "name": "nightly-package-base",
      "binaryDir": "${sourceDir}/build-presets/${presetName}",
      "inherits": [
        "common-base",
        "non-maintainer"
      ],
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "/",
        "USE_MINIMAL_DEBUGINFO": "On",
        "USE_STRICT_OPENSSL_VERSION": "On",
        "USE_V8": "On",
        "USE_FRONTEND": "On",
        "BUILD_REPO_INFO": "nightly",
        "CMAKE_C_FLAGS": "-fno-stack-protector",
        "CMAKE_CXX_FLAGS": "-fno-stack-protector",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1 -fno-stack-protector -fuse-ld=lld -fopenmp=libgomp -llapack -lgfortran",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "nightly-package-x64",
      "inherits": [
        "nightly-package-base",
        "x64"
      ],
      "displayName": "Nightly package build (static release, Enterprise, x64)"
    },
    {
      "name": "nightly-package-arm64",
      "inherits": [
        "nightly-package-base",
        "arm64"
      ],
      "displayName": "Nightly package build (static release, Enterprise, ARM64)"
    },
    {
      "hidden": true,
      "name": "developer-base",
      "binaryDir": "${sourceDir}/build-presets/${presetName}",
      "inherits": [
        "maintainer",
        "common-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_IPO": "Off",
        "USE_FAIL_ON_WARNINGS": "On",
        "USE_STRICT_OPENSSL_VERSION": "Off"
      }
    },
    {
      "name": "developer-x64",
      "inherits": [
        "developer-base",
        "x64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Developer Build) - x64"
    },
    {
      "name": "developer-arm64",
      "inherits": [
        "developer-base",
        "arm64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Developer Build) - ARM64"
    },
    {
      "name": "developer-x64-tsan",
      "inherits": [
        "tsan",
        "developer-x64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build, Developer) - x64"
