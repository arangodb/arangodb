{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "hidden": true,
      "name": "pr-base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fno-stack-protector",
        "CMAKE_CXX_FLAGS": "-fno-stack-protector",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1 -fuse-ld=lld",
        "USE_STRICT_OPENSSL_VERSION": "On",
        "STATIC_EXECUTABLES": "On"
      }
    },
    {
      "hidden": true,
      "name": "release-base",
      "binaryDir": "${sourceDir}/build-presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USE_ENTERPRISE": "Off",
        "USE_JEMALLOC": "On",
        "USE_IPO": "On",
        "USE_GOOGLE_TESTS": "Off",
        "USE_FAILURE_TESTS": "Off",
        "STATIC_EXECUTABLES": "On"
      }
    },
    {
      "hidden": true,
      "name": "x86_64",
      "cacheVariables": {
        "TARGET_ARCHITECTURE": "haswell",
        "USE_IPO": "On"
      }
    },
    {
      "hidden": true,
      "name": "arm",
      "cacheVariables": {
        "TARGET_ARCHITECTURE": "graviton2",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "ASM_OPTIMIZATIONS": "Off",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "pr-x86_64",
      "inherits": [
        "pr-base",
        "x86_64"
      ]
    },
    {
      "hidden": true,
      "name": "pr-arm",
      "inherits": [
        "pr-base",
        "arm"
      ]
    },
    {
      "hidden": true,
      "name": "maintainer",
      "cacheVariables": {
        "USE_MAINTAINER_MODE": "On",
        "USE_GOOGLE_TESTS": "On",
        "USE_FAILURE_TESTS": "On"
      }
    },
    {
      "hidden": true,
      "name": "tsan",
      "cacheVariables": {
        "USE_JEMALLOC": "Off",
        "STATIC_EXECUTABLES": "Off",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fsanitize-blacklist=${sourceDir}/tsan_blacklist.txt",
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "USE_MINIMAL_DEBUGINFO": "On",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "alubsan",
      "cacheVariables": {
        "USE_JEMALLOC": "Off",
        "STATIC_EXECUTABLES": "Off",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fsanitize=leak -fsanitize=undefined -fsanitize=float-divide-by-zero -fsanitize-address-use-after-return=never -fno-sanitize=vptr -fno-sanitize=alignment -fsanitize-blacklist=${sourceDir}/alubsan_blacklist.txt",
        "CMAKE_C_FLAGS": "-fsanitize=address -fsanitize=leak -fsanitize=undefined -fsanitize=float-divide-by-zero -fsanitize-address-use-after-return=never -fno-sanitize=alignment -fsanitize-blacklist=${sourceDir}/alubsan_blacklist.txt",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1 -rtlib=compiler-rt -fuse-ld=lld",
        "USE_MINIMAL_DEBUGINFO": "On",
        "USE_IPO": "Off"
      }
    },
    {
      "hidden": true,
      "name": "gcov",
      "cacheVariables": {
        "USE_COVERAGE": "On",
        "USE_JEMALLOC": "On"
      }
    },
    {
      "hidden": true,
      "name": "no-v8",
      "cacheVariables": {
        "USE_V8": "Off"
      }
    },
    {
      "hidden": true,
      "name": "nightly-base",
      "binaryDir": "${sourceDir}/build-presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "/",
        "STATIC_EXECUTABLES": "On",
        "USE_ENTERPRISE": "On",
        "USE_MAINTAINER_MODE": "Off",
        "USE_GOOGLE_TESTS": "Off",
        "USE_FAILURE_TESTS": "Off",
        "USE_CATCH_TESTS": "Off",
        "USE_JEMALLOC": "On",
        "USE_MINIMAL_DEBUGINFO": "On",
        "USE_STRICT_OPENSSL_VERSION": "On",
        "USE_V8": "On",
        "USE_FRONTEND": "On",
        "BUILD_REPO_INFO": "nightly",
        "CMAKE_C_FLAGS": "-fno-stack-protector",
        "CMAKE_CXX_FLAGS": "-fno-stack-protector",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1 -fno-stack-protector -fuse-ld=lld -fopenmp=libgomp -llapack -lgfortran",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "nightly-x86_64",
      "inherits": [
        "nightly-base",
        "x86_64"
      ],
      "displayName": "Nightly package build (static release, Enterprise, x86_64)"
    },
    {
      "name": "nightly-arm",
      "inherits": [
        "nightly-base",
        "arm"
      ],
      "displayName": "Nightly package build (static release, Enterprise, ARM)"
    },
    {
      "name": "enterprise",
      "inherits": "release-base",
      "displayName": "Build ArangoDB Enterprise Edition (Release Build)",
      "cacheVariables": {
        "USE_ENTERPRISE": "On"
      }
    },
    {
      "name": "enterprise-pr-x86_64-no-v8",
      "inherits": [
        "pr-x86_64",
        "enterprise",
        "no-v8"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition (without V8) - x86_64"
    },
    {
      "name": "enterprise-pr-non-maintainer-x86_64",
      "inherits": [
        "pr-x86_64",
        "enterprise"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition - x86_64"
    },
    {
      "name": "enterprise-pr-non-maintainer-arm",
      "inherits": [
        "pr-arm",
        "enterprise"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition - ARM"
    },
    {
      "name": "enterprise-pr-x86_64",
      "inherits": [
        "maintainer",
        "enterprise-pr-non-maintainer-x86_64"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition Maintainer Mode - x86_64"
    },
    {
      "name": "enterprise-pr-arm",
      "inherits": [
        "maintainer",
        "enterprise-pr-non-maintainer-arm"
      ],
      "displayName": "PR Build ArangoDB Enterprise Edition Maintainer Mode - ARM"
    },
    {
      "hidden": true,
      "name": "enterprise-developer-base",
      "inherits": [
        "maintainer",
        "enterprise"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_IPO": "Off",
        "USE_FAIL_ON_WARNINGS": "On",
        "USE_STRICT_OPENSSL_VERSION": "Off"
      }
    },
    {
      "name": "enterprise-developer-x86_64",
      "inherits": [
        "enterprise-developer-base",
        "x86_64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Developer Build) - x86_64"
    },
    {
      "name": "enterprise-developer-arm",
      "inherits": [
        "enterprise-developer-base",
        "arm"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Developer Build) - ARM"
    },
    {
      "name": "enterprise-developer-x86_64-tsan",
      "inherits": [
        "tsan",
        "enterprise-developer-x86_64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build, Developer) - x86_64"
    },
    {
      "name": "enterprise-developer-arm-tsan",
      "inherits": [
        "tsan",
        "enterprise-developer-arm"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build, Developer) - ARM"
    },
    {
      "name": "enterprise-pr-x86_64-tsan",
      "inherits": [
        "tsan",
        "enterprise-pr-x86_64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build) - x86_64"
    },
    {
      "name": "enterprise-pr-arm-tsan",
      "inherits": [
        "tsan",
        "enterprise-pr-arm"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (TSAN Build) - ARM"
    },
    {
      "name": "enterprise-developer-x86_64-alubsan",
      "inherits": [
        "alubsan",
        "enterprise-developer-x86_64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build, Developer) - x86_64"
    },
    {
      "name": "enterprise-developer-arm-alubsan",
      "inherits": [
        "alubsan",
        "enterprise-developer-arm"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build, Developer) - ARM"
    },
    {
      "name": "enterprise-pr-x86_64-alubsan",
      "inherits": [
        "alubsan",
        "enterprise-pr-x86_64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build) - x86_64"
    },
    {
      "name": "enterprise-pr-arm-alubsan",
      "inherits": [
        "alubsan",
        "enterprise-pr-arm"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (ASAN and UBSAN Build) - ARM"
    },
    {
      "name": "enterprise-developer-x86_64-coverage",
      "inherits": [
        "gcov",
        "enterprise-developer-x86_64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Coverage Build, Developer) - x86_64"
    },
    {
      "name": "enterprise-developer-arm-coverage",
      "inherits": [
        "gcov",
        "enterprise-developer-arm"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (Coverage Build, Developer) - ARM"
    }
  ],
