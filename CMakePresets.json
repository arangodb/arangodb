    },
    {
      "name": "developer-x64-no-v8",
      "inherits": [
        "no-v8",
        "developer-x64"
      ],
      "displayName": "Build ArangoDB Enterprise Edition (No V8/Frontend, Developer) - x64"
    },
    {
