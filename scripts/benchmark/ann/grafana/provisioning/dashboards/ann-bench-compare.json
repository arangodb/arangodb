{
  "uid": "ann-bench-compare",
  "title": "ann-benchmarks compare runs",
  "tags": [
    "ann-benchmarks",
    "arangodb"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "dataset",
        "label": "Dataset",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "bench"
        },
        "refresh": 1,
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "dataset",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/_db/ann-bench/_api/cursor",
            "url_options": {
              "method": "POST",
              "body_type": "raw",
              "body_content_type": "application/json",
              "data": "{\"query\": \"FOR d IN dataset SORT d.name RETURN {__text: d.name, __value: d.name}\", \"batchSize\": 100000}"
            },
            "root_selector": "result",
            "columns": []
          },
          "query": ""
        },
        "definition": "FOR d IN dataset SORT d.name RETURN {__text: d.name, __value: d.name}",
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "image",
        "label": "Image",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "bench"
        },
        "refresh": 1,
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "image",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/_db/ann-bench/_api/cursor",
            "url_options": {
              "method": "POST",
              "body_type": "raw",
              "body_content_type": "application/json",
              "data": "{\"query\": \"FOR r IN run COLLECT image = r.docker_image_version SORT image RETURN {__text: image, __value: image}\", \"batchSize\": 100000}"
            },
            "root_selector": "result",
            "columns": []
          },
          "query": ""
        },
        "definition": "FOR r IN run COLLECT image = r.docker_image_version SORT image RETURN {__text: image, __value: image}",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 0,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "candidate",
        "label": "Candidate run",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "bench"
        },
        "refresh": 1,
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "candidate",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/_db/ann-bench/_api/cursor",
            "url_options": {
              "method": "POST",
              "body_type": "raw",
              "body_content_type": "application/json",
              "data": "{\"query\": \"FOR r IN run FILTER r.docker_image_version IN [${image:singlequote}] SORT r.started_at DESC RETURN {__text: CONCAT(CONCAT(SUBSTRING(r.started_at, 0, 16), ' ', (CONTAINS(r.docker_image_version, ' ') ? REGEX_REPLACE(r.docker_image_version, '@([0-9a-f]{7})[0-9a-f]*$', '@$1') : LAST(SPLIT(r.docker_image_version, '/'))), ' ', FIRST(SPLIT(r.arangodb_version, ','))), ' (', r._key, ')'), __value: r._key}\", \"batchSize\": 100000}"
            },
            "root_selector": "result",
            "columns": []
          },
          "query": ""
        },
        "definition": "FOR r IN run FILTER r.docker_image_version IN [${image:singlequote}] SORT r.started_at DESC RETURN {__text: CONCAT(CONCAT(SUBSTRING(r.started_at, 0, 16), ' ', (CONTAINS(r.docker_image_version, ' ') ? REGEX_REPLACE(r.docker_image_version, '@([0-9a-f]{7})[0-9a-f]*$', '@$1') : LAST(SPLIT(r.docker_image_version, '/'))), ' ', FIRST(SPLIT(r.arangodb_version, ','))), ' (', r._key, ')'), __value: r._key}",
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "baseline",
        "label": "Baseline run",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "bench"
        },
        "refresh": 1,
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "baseline",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/_db/ann-bench/_api/cursor",
            "url_options": {
              "method": "POST",
              "body_type": "raw",
              "body_content_type": "application/json",
              "data": "{\"query\": \"LET c = DOCUMENT('run', '$candidate') FOR r IN run FILTER r._key != c._key LET previous = r.docker_image_version == c.docker_image_version AND r.started_at < c.started_at SORT previous DESC, r.started_at DESC RETURN {__text: CONCAT(CONCAT(SUBSTRING(r.started_at, 0, 16), ' ', (CONTAINS(r.docker_image_version, ' ') ? REGEX_REPLACE(r.docker_image_version, '@([0-9a-f]{7})[0-9a-f]*$', '@$1') : LAST(SPLIT(r.docker_image_version, '/'))), ' ', FIRST(SPLIT(r.arangodb_version, ','))), ' (', r._key, ')'), __value: r._key}\", \"batchSize\": 100000}"
            },
            "root_selector": "result",
            "columns": []
          },
          "query": ""
        },
        "definition": "LET c = DOCUMENT('run', '$candidate') FOR r IN run FILTER r._key != c._key LET previous = r.docker_image_version == c.docker_image_version AND r.started_at < c.started_at SORT previous DESC, r.started_at DESC RETURN {__text: CONCAT(CONCAT(SUBSTRING(r.started_at, 0, 16), ' ', (CONTAINS(r.docker_image_version, ' ') ? REGEX_REPLACE(r.docker_image_version, '@([0-9a-f]{7})[0-9a-f]*$', '@$1') : LAST(SPLIT(r.docker_image_version, '/'))), ' ', FIRST(SPLIT(r.arangodb_version, ','))), ' (', r._key, ')'), __value: r._key}",
        "current": {},
        "options": [],
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "xychart",
      "pluginVersion": "12.4.10",
      "title": "Recall vs QPS  ($dataset, exact k-nn, baseline vs candidate)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "bench"
      },
      "options": {
        "mapping": "auto",
        "series": [
          {}
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "show": "points+lines",
            "pointSize": {
              "fixed": 7
            },
            "lineWidth": 1,
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "qps"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.labels.run}"
              },
              {
                "id": "custom.axisLabel",
                "value": "QPS"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "recall"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "recall"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "recall": 0,
              "qps": 1,
              "run": 2,
              "params": 3
            }
          }
        },
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "run"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/_db/ann-bench/_api/cursor",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"query\": \"FOR m IN measurement_recall_qps FILTER m.run_id IN ['$baseline', '$candidate'] FILTER m.epsilon == 0 LET d = DOCUMENT('dataset', m.dataset_id) FILTER d.name == '$dataset' LET r = DOCUMENT('run', m.run_id) LET ix = DOCUMENT('index_setup', m.index_id) SORT r.started_at, m.recall RETURN {recall: m.recall, qps: m.qps, run: CONCAT(SUBSTRING(r.started_at, 0, 16), ' ', (CONTAINS(r.docker_image_version, ' ') ? REGEX_REPLACE(r.docker_image_version, '@([0-9a-f]{7})[0-9a-f]*$', '@$1') : LAST(SPLIT(r.docker_image_version, '/'))), ' ', FIRST(SPLIT(r.arangodb_version, ','))), params: ix.index_params.descriptor}\", \"batchSize\": 100000}"
          },
          "root_selector": "result",
          "columns": [
            {
              "selector": "recall",
              "text": "recall",
              "type": "number"
            },
            {
              "selector": "qps",
              "text": "qps",
              "type": "number"
            },
            {
              "selector": "run",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "params",
              "text": "params",
              "type": "string"
            }
          ]
        }
      ]
    },
