            "data": "{\"query\": \"FOR m IN measurement_recall_lat FILTER m.run_id IN ['$baseline', '$candidate'] FILTER m.percentile == 99.9 LET d = DOCUMENT('dataset', m.dataset_id) FILTER d.name == '$dataset' LET r = DOCUMENT('run', m.run_id) LET ix = DOCUMENT('index_setup', m.index_id) SORT r.started_at, m.recall RETURN {recall: m.recall, latency_ms: m.latency, run: CONCAT(SUBSTRING(r.started_at, 0, 16), ' ', (CONTAINS(r.docker_image_version, ' ') ? REGEX_REPLACE(r.docker_image_version, '@([0-9a-f]{7})[0-9a-f]*$', '@$1') : LAST(SPLIT(r.docker_image_version, '/'))), ' ', FIRST(SPLIT(r.arangodb_version, ','))), params: ix.index_params.descriptor}\", \"batchSize\": 100000}"
          },
          "root_selector": "result",
          "columns": [
            {
              "selector": "recall",
              "text": "recall",
              "type": "number"
            },
            {
              "selector": "latency_ms",
              "text": "latency_ms",
              "type": "number"
            },
            {
              "selector": "run",
              "text": "run",
              "type": "string"
            },
            {
              "selector": "params",
