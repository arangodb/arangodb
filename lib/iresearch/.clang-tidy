# clang-tidy configuration for the vendored iresearch tree.
#
# iresearch was developed as a standalone third-party library and still follows
# a different code style (snake_case identifiers, etc.). Historically it shipped
# its own comprehensive config here (Checks: '*' with WarningsAsErrors: '*'),
# which produces ~14k findings on this tree -- far too many to serve as a build
# gate, and mostly from checks we intentionally do not run elsewhere
# (readability-identifier-naming, readability-magic-numbers, misc-include-cleaner,
# hicpp-*, cppcoreguidelines-*, ...).
#
# For now iresearch is treated as first-party and INHERITS the repository-root
# .clang-tidy -- the same conservative, opt-in check set used across
# arangod/lib/client-tools/enterprise. On this tree that is a few hundred
# findings, in line with the rest of the codebase, and safe under USE_CLANG_TIDY
# (which runs clang-tidy at build time via CXX_CLANG_TIDY).
#
# InheritParentConfig makes the options here layer on top of the root config
# instead of replacing it; WarningsAsErrors is inherited (empty) from the root.
InheritParentConfig: true

# No `Checks:` here on purpose -- the enabled checks come from the root config.
# To re-introduce iresearch-specific checks later (a dedicated effort), append
# them here, e.g.:
#   Checks: 'readability-identifier-naming, readability-magic-numbers'

# iresearch's historical identifier-naming scheme (snake_case). RETAINED but
# DORMANT: the root config does not enable readability-identifier-naming, so
# these options have no effect until that check is added to `Checks` above.
# Kept so that a future iresearch-specific naming pass is a one-line change.
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.ClassMemberCase
    value: lower_case
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^[A-Z]+(_[A-Z]+)*_$'
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.IgnoreMainLikeFunctions
    value: 1
  - key: readability-simplify-boolean-expr.ChainedConditionalReturn
    value: 1
  - key: readability-simplify-boolean-expr.ChainedConditionalAssignment
    value: 1
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: 1
